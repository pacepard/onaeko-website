# Copy to .env for local dev. Next inlines only NEXT_PUBLIC_* at build time.
# Catalogue helper (P115) must fail closed if the public API base is missing.
# Never set NEXT_PUBLIC_USE_MOCKS outside local. Production ignores it.

NEXT_PUBLIC_APP_API_URL=http://localhost:5015/api/v1
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:5401
NEXT_PUBLIC_LEARN_URL=http://localhost:5402

# Recommended mock rail only (idea.md §22.10). Leave unset to hit the real API.
# Production ignores NEXT_PUBLIC_USE_MOCKS even if set. Never set outside local.
# NEXT_PUBLIC_APP_API_URL may be omitted while mocks are on.
# NEXT_PUBLIC_USE_MOCKS=true
